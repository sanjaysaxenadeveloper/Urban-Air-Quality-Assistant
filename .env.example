# ==============================================================================
# Urban Air Quality Assistant — Environment Variables
# Copy to .env for local development. Never commit real secrets to git.
# ==============================================================================

# --- Core Server & AI ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Air Quality Data Providers (Optional keys; falls back to free Open-Meteo) ---
# Primary ground station data: https://explore.openaq.org/
OPENAQ_API_KEY=""
# Official Indian CPCB real-time feed: https://data.gov.in/
DATA_GOV_IN_API_KEY=""
# World Air Quality Index station feed: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=""

# --- Cache & Outbound Request Tuning ---
AIR_CACHE_TTL_MS="720000"
PROVIDER_TIMEOUT_MS="6000"

# --- Internal Scheduler Security (Cloud Scheduler -> POST /internal/check-alerts) ---
SCHEDULER_SECRET="CHANGE_ME_STRONG_RANDOM_SECRET"
SCHEDULER_OIDC_AUDIENCE=""

# --- Firebase Server (Cloud Run / User-Owned GCP Project via ADC) ---
FIREBASE_PROJECT_ID=""
FIREBASE_DATABASE_ID=""

# --- Frontend Public Config (VITE_*) ---
# Web Push VAPID key from Firebase Console -> Project Settings -> Cloud Messaging
VITE_FIREBASE_VAPID_KEY=""
# Paste your YouTube tutorial link (standard watch URL or youtu.be URL)
VITE_TUTORIAL_VIDEO_URL="https://www.youtube.com/watch?v=dQw4w9WgXcQ"
# Feedback or community contact link shown in Help & Footer
VITE_FEEDBACK_URL="mailto:support@urbanairassistant.example"
